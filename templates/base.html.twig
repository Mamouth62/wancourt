<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link href="https://bootswatch.com/5/journal/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        body, html {
            height: 100%;
            margin: 0;
            display: flex;
            flex-direction: column;
        }
        .main-content {
            flex: 1;
        }
        .navbar-custom {
            background-color: #003366; /* Bleu foncé */
        }
        .navbar-custom .navbar-brand,
        .navbar-custom .nav-link,
        .navbar-custom .navbar-text {
            color: #ffffff; /* Blanc */
        }
        .navbar-custom .nav-link:hover,
        .navbar-custom .nav-link:focus {
            color: #dddddd; /* Gris clair pour le survol */
        }
        body {
            background-color: #f8f9fa; /* Gris clair */
            color: #343a40; /* Gris foncé */
            font-family: 'Arial', sans-serif; /* Police appropriée */
        }
        .text-center h1 {
            font-family: 'Georgia', serif; /* Police appropriée pour les titres */
        }
        .text-center img {
            max-width: 50%; /* Réduire la taille de l'image */
            height: auto;
            display: block;
            margin: 0 auto;
        }
        .btn-dark-blue {
            background-color: #003366; /* Bleu foncé */
            color: white; /* Texte en blanc */
        }
        .btn-dark-blue:hover {
            background-color: #002244; /* Bleu foncé légèrement plus sombre pour le survol */
            color: white;
        }
        .blason-container {
            text-align: center;
            margin: 20px 0;
        }
        .blason-container img {
            max-width: 10%;
            height: auto;
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-custom" data-bs-theme="dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{ path('app_base') }}">Wancourt</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarColor01">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_journal') }}">Journal</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="{{ path('app_mairie') }}" role="button" aria-haspopup="true" aria-expanded="false">Mairie</a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" href="{{ path('app_agenda') }}">Agenda</a>
                            <a class="dropdown-item" href="{{ path('app_horaire') }}">Horaires</a>
                            <a class="dropdown-item" href="{{ path('app_info') }}">Informations</a>
                            <a class="dropdown-item" href="{{ path('app_commissions_et_delegations') }}">Commissions et Délégations</a>
                            <a class="dropdown-item" href="{{ path('app_arrete_communaux') }}">Arrêtés Communaux</a>
                            <a class="dropdown-item" href="{{ path('app_cimetiere') }}">Cimetière</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="{{ path('app_mairie') }}">Tout</a>
                        </div>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Vie Pratique</a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" href="{{ path('app_etat_civil') }}">État civil</a>
                            <a class="dropdown-item" href="{{ path('app_carte_nationale_identite') }}">Carte nationale d'identité</a>
                            <a class="dropdown-item" href="{{ path('app_passeport_biometrique') }}">Passeport biométrique</a>
                            <a class="dropdown-item" href="{{ path('app_certificat') }}">Certificat...</a>
                            <a class="dropdown-item" href="{{ path('app_election') }}">Élection</a>
                            <a class="dropdown-item" href="{{ path('app_armee') }}">Armée</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="{{ path('app_vie_pratique') }}">Tout</a>
                        </div>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Vie Associative</a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" href="{{ path('app_fitclub') }}">Fitclub</a>
                            <a class="dropdown-item" href="{{ path('app_association_parents_eleves') }}">Association parents d'élèves</a>
                            <a class="dropdown-item" href="{{ path('app_amicale_des_anciens') }}">Amicale des anciens</a>
                            <a class="dropdown-item" href="{{ path('app_sophrologie') }}">Sophrologie</a>
                            <a class="dropdown-item" href="{{ path('app_art_coeur') }}">Art'coeur</a>
                            <a class="dropdown-item" href="{{ path('app_bibliotheque') }}">Bibliothèque</a>
                            <a class="dropdown-item" href="{{ path('app_comite_des_fetes') }}">Comité des fêtes</a>
                            <a class="dropdown-item" href="{{ path('app_endurance') }}">Endurance</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="{{ path('app_vie_associative') }}">Tout</a>
                        </div>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Location de salle</a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" href="{{ path('app_rue_flandres') }}">Rue de Flandres</a>
                            <a class="dropdown-item" href="{{ path('app_rue_alsace') }}">Rue d'Alsace</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="{{ path('app_location_des_salles') }}">Tout</a>
                        </div>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Education</a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" href="{{ path('app_rpi') }}">RPI</a>
                            <a class="dropdown-item" href="{{ path('app_assistantes_maternelles') }}">Relais Des Assistantes Matérielles</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="{{ path('app_education') }}">Tout</a>
                        </div>
                    </li>
                </ul>
                <form class="d-flex">
                    <input class="form-control me-sm-2" type="search" placeholder="Search">
                    <button class="btn btn-secondary my-2 my-sm-0" type="submit">Rechercher</button>
                </form>
            </div>
        </div>
    </nav>
    <main class="main-content">
        {% block body %}{% endblock %}
    </main>
    <footer class="bg-dark text-white mt-5">
        <div class="container py-4">
            <div class="row">
                <!-- Informations de contact -->
                <div class="col-md-4">
                    <h5>Contact</h5>
                    <p>
                        Mairie de Wancourt<br>
                        3 Rue de Picardie<br>
                        62128 Wancourt, France<br>
                        Téléphone : 03 21 48 15 86<br>
                        Email : mairie@wancourt.fr
                    </p>
                </div>
                <!-- Liens utiles -->
                <div class="col-md-4">
                    <h5>Liens Utiles</h5>
                    <ul class="list-unstyled">
                        <li><a href="{{ path('app_base') }}" class="text-white">Accueil</a></li>
                        <li><a href="{{ path('app_journal') }}" class="text-white">Journal</a></li>
                        <li><a href="{{ path('app_mairie') }}" class="text-white">Mairie</a></li>
                        <li><a href="{{ path('app_vie_pratique') }}" class="text-white">Vie Pratique</a></li>
                        <li><a href="{{ path('app_vie_associative') }}" class="text-white">Vie Associative</a></li>
                        <li><a href="{{ path('app_location_des_salles') }}" class="text-white">Location des salles</a></li>
                    </ul>
                </div>
                <!-- Réseaux sociaux -->
                <div class="col-md-4">
                    <h5>Suivez-nous</h5>
                    <a href="#" class="text-white me-2"><i class="fab fa-facebook fa-2x"></i></a>
                </div>
            </div>
            <div class="text-center mt-4">
                &copy; {{ "now"|date("Y") }} Mairie de Wancourt. Tous droits réservés.
            </div>
        </div>
    </footer>
    {% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    {% endblock %}
</body>
</html>
