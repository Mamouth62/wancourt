    <style>
        body {
            background: linear-gradient(to right, #f8f9fa, #e9ecef);
            color: #343a40;
            font-family: 'Times New Roman', Times, serif;
        }
        h1 {
            font-family: 'Georgia', serif;
            font-weight: bold;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
            text-align: center;
            margin-top: 20px;
        }
        .container-fluid {
            background: white;
            padding: 30px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            margin-top: 20px;
        }
        .headline {
            border-bottom: 2px solid #343a40;
            margin-bottom: 20px;
            padding-bottom: 10px;
        }
        .article-summary h2 {
            font-size: 1.5rem;
            font-weight: bold;
            margin-bottom: 15px;
        }
        .article-content {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            height: 100%;
            padding: 20px;
            background: rgba(255, 255, 255, 0.9);
        }
        .img-fluid {
            max-width: 100%;
            height: auto;
        }
        .img-small {
            max-width: 50%;
            height: auto;
        }
        .btn-dark-blue {
            background-color: #343a40;
            border-color: #343a40;
            color: #fff;
            transition: background-color 0.2s, box-shadow 0.2s;
        }
        .btn-dark-blue:hover {
            background-color: #1d2124;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        .container {
            margin-bottom: 50px;
        }
        .navbar {
            background-color: #343a40;
        }
        .navbar a {
            color: #000 !important;
        }
        .navbar-brand {
            font-family: 'Georgia', serif;
            color: #000 !important;
        }
        .dropdown-menu {
            background-color: #343a40;
        }
        .dropdown-menu a {
            color: #fff !important;
        }
        .dropdown-menu a:hover {
            background-color: #1d2124 !important;
        }
    </style>
</head>
