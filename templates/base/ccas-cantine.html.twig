{% extends 'base.html.twig' %}

{% block title %}Wancourt CCAS-
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		body {
			background: url('{{ asset('img/mairie.JPG') }}') no-repeat center center fixed;
			background-size: cover;
		}

		.container {
			max-width: 800px;
			margin: 0 auto;
		}

		.content-wrapper {
			background-color: rgba(255, 255, 255, 0.85);
			padding: 20px;
			border-radius: 10px;
			margin-top: 20px;
			box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
		}
		.text-center img {
			max-width: 100%;
			height: auto;
			display: block;
			margin: 0 auto;
		}
	</style>
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<div class="content-wrapper">
			<h1 class="mb-4">CCAS Les aides à la cantine</h1>
			{% set img = 'img/ccas_p4.png' %}
			<div class="text-center">
				<img src="{{ asset(img) }}">
			</div>
			<div class="container mt-5 d-flex justify-content-between">
				<a href="{{ path('app_ccas_aides_ponctuelles') }}" class="btn btn-dark-blue mb-4">Retour à la Page CCAS</a>
				<button onclick="window.print()" class="btn btn-dark-blue mb-4">Imprimer</button>
			</div>
		</div><br><br>
	</div>
{% endblock %}
