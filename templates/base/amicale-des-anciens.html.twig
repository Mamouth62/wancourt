{% extends 'base.html.twig' %}

{% block title %}Wancourt -
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		body {
			background-color: #f8f9fa;
			color: #343a40;
			font-family: 'Arial', sans-serif;
		}
		.text-center img {
			max-width: 100%;
			height: auto;
			display: block;
			margin: 0 auto;
		}
		body {
			background-color: #f8f9fa; /* Gris clair */
			color: #343a40; /* Gris foncé */
			font-family: 'Arial', sans-serif; /* Police appropriée */
		}
		table {
			margin: 20px auto;
			width: 80%;
			border-collapse: collapse;
		}
		th,
		td {
			padding: 10px;
			border: 1px solid #dee2e6;
			text-align: center;
		}
		th {
			background-color: #003366; /* Bleu foncé */
			color: white;
		}
	</style>
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<h1 class="mb-4">Amicale des anciens</h1>
	</div>
	<div class="container">
		<div class="row">
			<div class="col-md-6 text-center">
				{% set img1 = 'img/ada.jpg' %}
				<img src="{{ asset(img1) }}" class="img-fluid" alt="Description de l'image 1">
			</div>
			<div class="col-md-6 text-center">
				{% set img2 = 'img/ada1.jpg' %}
				<img src="{{ asset(img2) }}" class="img-fluid" alt="Description de l'image 2">
			</div>
		</div>
