{% extends 'base.html.twig' %}

{% block title %}Wancourt - Amicale des Anciens{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            background: url('{{ asset('img/sdf.JPG') }}') no-repeat center center fixed;
            background-size: cover;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
        }

        .content-wrapper {
            background-color: rgba(255, 255, 255, 0.85);
            padding: 20px;
            border-radius: 10px;
            margin-top: 20px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        h1, h2, h3 {
            color: rgba(51, 51, 51, 0.8);
            text-align: center;
        }

        .text-center {
            text-align: center;
        }

        .table-container {
            margin: 20px auto;
            width: 100%;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 10px;
            border: 1px solid #dee2e6;
            text-align: center;
        }

        th {
            background-color: #6c757d;
            color: white;
        }

        td {
            background-color: #f8f9fa;
            color: #343a40;
        }

        .highlight-black {
            background-color: #343a40;
            color: white;
        }

        .highlight-orange {
            background-color: #ff5722;
            color: white;
        }

        .highlight-green {
            background-color: #28a745;
            color: white;
        }

        .highlight-blue {
            background-color: #007bff;
            color: white;
        }

        .highlight-yellow {
            background-color: #ffc107;
            color: #343a40;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="content-wrapper">
            <h1 class="mb-4">Amicale des Anciens</h1>
            <div class="container">
                <div class="row">
                    <div class="col-md-6 text-center">
                        {% set img1 = 'img/ada.jpg' %}
                        <img src="{{ asset(img1) }}" class="img-fluid" alt="Image de l'amicale des anciens">
                    </div>
                    <div class="col-md-6 text-center">
                        {% set img2 = 'img/ada1.jpg' %}
                        <img src="{{ asset(img2) }}" class="img-fluid" alt="Image des membres de l'amicale">
                    </div>
                </div>
            </div>
            <div class="container mt-5">
                <p>
                    L’amicale des anciens de Wancourt et d'Héninel s’adresse à toutes les personnes retraitées pour leur permettre de conserver des contacts humains et ne pas rester isolées.<br><br>
                    Un fois tous les 15 jours, le jeudi après-midi à partir de 14h00, nous nous retrouvons à la salle des associations, pour jouer aux cartes, aux jeux de société ou bavarder tout simplement autour d’une collation, toujours dans une ambiance courtoise et chaleureuse.<br><br>
                    Outre ces après-midis récréatives, nous organisons des sorties d’une journée, les repas d’anniversaire une fois par trimestre ainsi que notre repas de fin d’année.<br><br>
                    Le club est ouvert à tous et nous permet de se sentir moins seul(e)s, de se créer des amitiés et éventuellement s’épauler moralement.<br><br>
                    Nous vous attendons ….<br><br>
                    La cotisation annuelle est de 16€<br><br>
                    Président et contact :<br>
                    Monsieur Blondel Michel 03 21 48 14 21 ou 06-88-04-14-56<br><br>
                    Adresse Courriel : michel.blondel0245@orange.fr
                </p>
