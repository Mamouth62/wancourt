									<div class="mt-auto">
										<a href="{{ path('app_ccas_info_utile') }}" class="btn btn-dark-blue">Lire</a>
									</div>
								</div>
							</td>
							<td class="article-summary">
								<div class="article-content">
									<h2 class="h4 text-info">La mutuelle pour tous</h2>
									<p></p>
									{% set img8 = 'img/ccas_p11.png' %}
