{% extends 'base.html.twig' %}

{% block title %}Wancourt CCAS -
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		body {
			background: url('{{ asset('img/mairie.JPG') }}') no-repeat center center fixed;
			background-size: cover;
		}

		.container {
			max-width: 800px;
			margin: 0 auto;
		}

		.content-wrapper {
			background-color: rgba(255, 255, 255, 0.85);
			padding: 20px;
			border-radius: 10px;
			margin-top: 20px;
			box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
		}
		.img-small {
			width: 100%;
			max-width: 200px;
			height: 150px;
			object-fit: cover;
		}
		.table td {
			vertical-align: middle;
		}
		.mt-auto {
			margin-top: auto;
		}
	</style>
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<div class="content-wrapper">
			<h1 class="mb-4">CCAS AIDES PONCTUELLES</h1>
			<p class="mb-4 text-center">Cliquez sur l'article de votre choix pour lire le résumé complet.</p>
