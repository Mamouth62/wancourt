				<table class="table table-bordered text-center w-100">
					<tbody>
						<tr>
							<td class="article-summary">
								<div class="article-content">
									<h2 class="h4 text-info">Les aides à l'énergie
									</h2>
									<p></p>
									{% set img1 = 'img/ccas_p3.png' %}
									<img src="{{ asset(img1) }}" alt="Image article 1" class="img-fluid my-3 img-small">
									<div class="mt-auto">
										<a href="{{ path('app_ccas_aide_energie') }}" class="btn btn-dark-blue">Lire</a>
									</div>
								</div>
							</td>
							<td class="article-summary">
								<div class="article-content">
									<h2 class="h4 text-info">Les aides à la subsistance</h2>
