{% extends 'base.html.twig' %}

{% block title %}Passeports biométriques - Wancourt{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            background: url('{{ asset('img/aire_jeu_sdf.JPG') }}') no-repeat center center fixed;
            background-size: cover;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
        }

        .content-wrapper {
            background-color: rgba(255, 255, 255, 0.85);
            padding: 20px;
            border-radius: 10px;
            margin-top: 20px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        h1, h2, h3 {
            color: rgba(51, 51, 51, 0.8);
            text-align: center;
        }

        .text-center {
            text-align: center;
        }

        .content-section {
            margin-top: 20px;
        }

        .content-section h2 {
            margin-bottom: 15px;
        }

        .content-section p {
            margin-bottom: 10px;
        }

        ul {
            color: rgba(51, 51, 51, 0.8);
            margin-left: 20px;
        }

        ul li {
            margin-bottom: 10px;
        }

        a {
            color: #007bff;
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="content-wrapper">
            <h1 class="mb-4 text-center">Passeports biométriques - Wancourt</h1>
            <div class="text-center">
                <img src="{{ asset('img/passeport.jpg') }}" class="img-fluid">
            </div>
            <div class="text-center mt-5">
                <a href="https://ants.gouv.fr/nos-missions/les-titres-produits-par-l-ants/les-documents-d-identite/le-passeport-biometrique" class="btn btn-dark-blue">Lien vers www.service-public.fr</a>
            </div>
            <div class="content-section">
                <h2>Procédure de demande de passeport biométrique</h2>
                <p>Pour obtenir un passeport biométrique, vous devez suivre les étapes suivantes :</p>
                <ol>
                    <li>Remplir le formulaire de demande en ligne sur le site officiel du gouvernement.</li>
                    <li>Prendre rendez-vous dans une mairie habilitée pour prendre les empreintes biométriques</li>
                    <li>Apporter les documents demandés</li>
                </ol>
            </div>
            <div class="container mt-5">
                <a href="{{ path('app_vie_pratique') }}" class="btn btn-dark-blue mb-4">Retour à la Vie Pratique</a>
            </div>
        </div>
    </div><br><br>
{% endblock %}

