{% extends 'base.html.twig' %}

{% block title %}Wancourt Journal-
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .text-center img {
            max-width: 100%;
            height: auto;
            display: block;
            margin: 0 auto;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4">Les Déchets Verts</h1>
    </div>
    {% set img = 'img/dechet-vert.jpg' %}
	<div class="text-center">
		<img src="{{ asset(img) }}">
	</div>
    <div class="container mt-5 d-flex justify-content-between">
        <a href="{{ path('app_planning') }}" class="btn btn-dark-blue mb-4">Retour à la Page Planning et Horaires</a>
        <button onclick="window.print()" class="btn btn-dark-blue mb-4">Imprimer</button>
    </div>
{% endblock %}
