{% extends 'base.html.twig' %}

{% block title %}Wancourt - Vie Associative{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .table td {
            text-align: center;
            vertical-align: middle;
            border: 1px solid #ddd;
            padding: 20px;
        }
        .btn-center {
            display: flex;
            justify-content: center;
        }
        .btn-center .btn {
            margin: 0 auto;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="headline text-primary">Vie Associative</h1>
        <p class="lead mb-4 text-center">Cliquez sur l'article de votre choix pour lire le résumé complet.</p>

        <div class="table-responsive">
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <td class="article-summary">
                            <h2 class="h4">AMICALE DES ANCIENS</h2>
                            <p>Description de l'Amicale des Anciens.</p>
                            <div class="btn-center">
                                <a href="{{ path('app_amicale_des_anciens') }}" class="btn btn-dark-blue mb-4">Voir</a>
                            </div>
                        </td>
                        <td class="article-summary">
                            <h2 class="h4">ASSOCIATION PARENTS D'ELEVES</h2>
                            <p>Description de l'Association des Parents d'Élèves.</p>
                            <div class="btn-center">
                                <a href="{{ path('app_association_parents_eleves') }}" class="btn btn-dark-blue mb-4">Voir</a>
                            </div>
                        </td>
                        <td class="article-summary">
                            <h2 class="h4">BIBLIOTHÈQUE DE WANCOURT</h2>
                            <p>Description de la Bibliothèque de Wancourt.</p>
                            <div class="btn-center">
                                <a href="{{ path('app_bibliotheque') }}" class="btn btn-dark-blue mb-4">Voir</a>
                            </div>
                        </td>
                        <td class="article-summary">
                            <h2 class="h4">COMITÉ DES FÊTES</h2>
                            <p>Description du Comité des Fêtes.</p>
                            <div class="btn-center">
                                <a href="{{ path('app_comite_des_fetes') }}" class="btn btn-dark-blue mb-4">Voir</a>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="article-summary">
                            <h2 class="h4">LES ART'COEUR</h2>
                            <p>Description des Art'coeur.</p>
                            <div class="btn-center">
                                <a href="{{ path('app_art_coeur') }}" class="btn btn-dark-blue mb-4">Voir</a>
                            </div>
                        </td>
                        <td class="article-summary">
                            <h2 class="h4">SOPHROLOGIE</h2>
                            <p>Description de la Sophrologie à Wancourt.</p>
                            <div class="btn-center">
                                <a href="{{ path('app_sophrologie') }}" class="btn btn-dark-blue mb-4">Voir</a>
                            </div>
                        </td>
                        <td class="article-summary">
                            <h2 class="h4">WANCOURT ENDURANCE</h2>
                            <p>Description de Wancourt Endurance.</p>
                            <div class="btn-center">
                                <a href="{{ path('app_endurance') }}" class="btn btn-dark-blue mb-4">Voir</a>
                            </div>
                        </td>
                        <td class="article-summary">
                            <h2 class="h4">WANCOURT FITCLUB</h2>
                            <p>Description du Wancourt Fitclub.</p>
                            <div class="btn-center">
                                <a href="{{ path('app_fitclub') }}" class="btn btn-dark-blue mb-4">Voir</a>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="container mt-5 text-center">
        <a href="{{ path('app_base') }}" class="btn btn-dark-blue">Retour à la Page Principale</a>
    </div><br>
{% endblock %}

