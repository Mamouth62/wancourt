{% extends 'base.html.twig' %}

{% block title %}Wancourt -
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		body {
			background-color: #f8f9fa;
			color: #343a40;
			font-family: 'Arial', sans-serif;
		}
		.text-center img {
			max-width: 100%;
			height: auto;
			display: block;
			margin: 0 auto;
		}
	</style>
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<h1 class="mb-4">Association des parents d'élèves</h1>
		<div class="text-center">
			<h5>Association des parents d'élèves du RPI Fontaine, Chérisy,<br>
				Guémappe, Héninel et Wancourt
				{% set img = 'img/LOGO_APE.jpg' %}
				<img src="{{ asset(img) }}" class="img-fluid mx-auto"><br><br>
				{% set img1 = 'img/BUREAU_2023.jpg' %}
				<img src="{{ asset(img1) }}" class="img-fluid mx-auto"><br><br>
				{% set img2 = 'img/Bon_commande_noel_2023.jpg' %}
				<img src="{{ asset(img2) }}" class="img-fluid mx-auto">
			</h5>
		</div>
	</div>
{% endblock %}
