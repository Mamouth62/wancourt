{% extends 'base.html.twig' %}

{% block title %}Wancourt - Association des parents d'élèves
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
    body {
			background: url('{{ asset('img/sdf.JPG') }}') no-repeat center center fixed;
			background-size: cover;
		}

		.container {
			max-width: 800px;
			margin: 0 auto;
		}

		.content-wrapper {
			background-color: rgba(255, 255, 255, 0.85);
			padding: 20px;
			border-radius: 10px;
			margin-top: 20px;
			box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
		}
        
		table {
			margin: 20px auto;
			width: 80%;
			border-collapse: collapse;
		}
		th,
		td {
			padding: 10px;
			border: 1px solid #dee2e6;
			text-align: center;
		}
		th {
			background-color: #003366;
			color: white;
		}
		
		h1,
		h2,
		h3 {
			color: rgba(51, 51, 51, 0.8);
			text-align: center;
		}

		.text-center {
			text-align: center;
		}
	</style>
{% endblock %}


{% block body %}
	<div class="container mt-5">
		<div class="content-wrapper">
			<h1 class="mb-4">Association des parents d'élèves</h1>
			<div class="text-center">
				<h5>Association des parents d'élèves du RPI Fontaine, Chérisy,<br>
					Guémappe, Héninel et Wancourt</h5>
				{% set img = 'img/LOGO_APE.jpg' %}
				<img src="{{ asset(img) }}" class="img-fluid mx-auto"><br><br>
				{% set img1 = 'img/BUREAU_2023.jpg' %}
				<img src="{{ asset(img1) }}" class="img-fluid mx-auto"><br><br>
				<div class="container mt-5 d-flex justify-content-between">
					<a href="{{ path('app_vie_associative') }}" class="btn btn-dark-blue ">Retour à la Page Vie Associative</a>
					<button onclick="window.print()" class="btn btn-dark-blue ">Imprimer</button>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
