{% extends 'base.html.twig' %}

{% block title %}Wancourt Journal-
{% endblock %}

{% block stylesheets %}
<style>
    .image-container img {
        max-width: 100%; 
        height: auto; 
        max-height: 500px; 
        margin: 0 auto; 
    }
</style>
{% endblock %}

{% block body %}
    <div class="container mt-5 text-center">
        <h1 class="mb-4">Election Juin 2024</h1>
        {% set img = 'img/elus_juin_2024.jpg' %}
        <div class="image-container text-center mb-4">
            <img src="{{ asset(img) }}">
        </div>
    <div class="container mt-5 d-flex justify-content-between">
        <a href="{{ path('app_journal') }}" class="btn btn-dark-blue mb-4">Retour à la Page Journal</a>
        <button onclick="window.print()" class="btn btn-dark-blue mb-4">Imprimer</button>
    </div>
{% endblock %}