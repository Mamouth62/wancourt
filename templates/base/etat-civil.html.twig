{% extends 'base.html.twig' %}

{% block title %}État Civil - Wancourt{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            background: url('{{ asset('img/aire_jeu_sdf.JPG') }}') no-repeat center center fixed;
            background-size: cover;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
        }

        .content-wrapper {
            background-color: rgba(255, 255, 255, 0.85);
            padding: 20px;
            border-radius: 10px;
            margin-top: 20px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        h1, h2, h3 {
            color: rgba(51, 51, 51, 0.8);
            text-align: center;
        }

        .text-center {
            text-align: center;
        }

        .btn-dark-blue {
            background-color: #343a40;
            color: #fff;
            border: none;
            border-radius: 5px;
            padding: 10px 20px;
            text-align: center;
            display: inline-block;
            font-size: 16px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .btn-dark-blue:hover {
            background-color: #23272b;
        }

        .content-section {
            margin-top: 20px;
        }

        .content-section h2 {
            margin-bottom: 15px;
        }

        .content-section p {
            margin-bottom: 10px;
        }

        ul {
            color: rgba(51, 51, 51, 0.8);
            margin-left: 20px;
        }

        ul li {
            margin-bottom: 10px;
        }

        a {
            color: #007bff;
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="content-wrapper">
            <h1 class="mb-4 text-center">État Civil</h1>
            <div class="content-section">
                <h2>Copie d'actes</h2>
                <p>Les copies d'actes de naissance, de mariage et de décès sont disponibles sur demande auprès de la mairie.</p>
                <p>Vous pouvez également effectuer votre demande en ligne sur le site des services publics.</p>
            </div>
            <div class="text-center mt-5">
                <a href="https://www.service-public.fr/particuliers/vosdroits/N359" class="btn btn-dark-blue">Lien vers www.service-public.fr</a>
            </div>
            <div class="container mt-5">
                <a href="{{ path('app_vie_pratique') }}" class="btn btn-dark-blue mb-4">Retour à la Vie Pratique</a>
            </div>
        </div>
    </div>
{% endblock %}

