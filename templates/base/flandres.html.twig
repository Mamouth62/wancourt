{% extends 'base.html.twig' %}

{% block title %}Wancourt - Salle des fêtes{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		.container {
			max-width: 800px;
			margin: 0 auto 30px;
			padding: 0 15px;
		}
		.text-center {
			text-align: center;
		}
		.img-fluid {
			max-width: 100%;
			height: auto;
			display: block;
			margin: 0 auto 20px;
			border-radius: 8px;
			box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
		}
		.section-title {
			margin-top: 30px;
			margin-bottom: 15px;
			font-size: 1.2rem;
			color: #343a40;
		}
		.pricing-list,
		.equipment-list {
			list-style-type: none;
			padding-left: 0;
		}
		.pricing-list li,
		.equipment-list li {
			margin-bottom: 8px;
		}
		.pricing-section {
			display: flex;
			justify-content: center;
		}
		.pricing-container {
			width: 50%;
		}
	</style>
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<h1 class="mb-4 text-center">Salle des fêtes</h1>

		<div class="text-center">
			<h4>
				Bienvenue à la salle des fêtes de Wancourt, idéale pour vos événements spéciaux
			</h4>
			<p>
				- Salle principale de 193 m² (capacité : 120 places assises ou 150 debout)<br>
				- Salle annexe de 24 m²<br>
				- Cuisine entièrement équipée.
			</p>
		</div>

		<div class="text-center">
			<img src="{{ asset('img/sdf.JPG') }}" class="img-fluid" alt="Salle des fêtes">
			<h5 class="section-title">Salle des Fêtes</h5>
		</div><br>

		<div class="row">
			<div class="col-md-4">
				<img src="{{ asset('img/panoramique.jpg') }}" class="img-fluid" alt="Panoramique de la salle">
				<h5 class="section-title">Panoramique</h5>
			</div>
			<div class="col-md-4">
				<img src="{{ asset('img/scene.jpg') }}" class="img-fluid" alt="Scène de la salle">
				<h5 class="section-title">Scène</h5>
			</div>
			<div class="col-md-4">
				<img src="{{ asset('img/bar.jpg') }}" class="img-fluid" alt="Bar de la salle">
				<h5 class="section-title">Bar</h5>
			</div>
		</div><br>

		<div class="row">
			<div class="col-md-6">
				<img src="{{ asset('img/cuisine.jpg') }}" class="img-fluid" alt="Cuisine de la salle">
				<h5 class="section-title">Cuisine</h5>
			</div>
			<div class="col-md-6">
				<img src="{{ asset('img/laverie.jpg') }}" class="img-fluid" alt="Laverie de la salle">
				<h5 class="section-title">Laverie</h5>
			</div>
		</div>

		<div class="text-center mt-4">
			<h4>Tarifs de location :</h4><br>

			<div class="pricing-section">
				<div class="pricing-container">
					<h5>Pour les Wancourtois :</h5>
					<ul class="pricing-list">
						<li>150€ la journée</li>
						<li>220€ le week-end</li>
						<li>60€ l'après-midi uniquement</li>
					</ul>
				</div>
				<div class="pricing-container">
					<h5>Pour les extérieurs :</h5>
					<ul class="pricing-list">
						<li>380€ la journée</li>
						<li>560€ le week-end</li>
						<li>140€ le lunch</li>
					</ul>
				</div>
			</div>

			<br><h4>Frais divers :</h4>
			<ul class="pricing-list">
				<li>Vaisselle couvert complet : 0,80€ par personne</li>
				<li>Verres seuls : 0,08€ le verre</li>
				<li>Electricité : 0,25€ par KWH</li>
				<li>Nettoyage : 15€ de l'heure</li>
				<li>Frais de casse et de réparation déterminés par la mairie</li>
				<li>Deux cautions : une pour la salle et une pour le dépassement du volume sonore</li>
				<li>Caution de la salle : 500€</li>
				<li>Caution volume sonore : 300€</li>
			</ul>

			<br><h4>Équipements :</h4>
			<ul class="equipment-list">
				<li>Salle principale (193 m²) avec bar</li>
				<li>Salle annexe, cloison amovible (24 m²)</li>
				<li>Estrade dans la salle principale (10,5 m²)</li>
				<li>Cuisine équipée</li>
				<li>Arrière-cuisine avec lave-vaisselle</li>
				<li>Vestiaire, sanitaires, hall</li>
				<li>Pièce de rangement pour tables et chaises</li>
				<li>Dimensions des tables : 1,20 m * 0,80 m</li>
			</ul>

			<p>Réservation en Mairie.</p>
		</div>

		<div class="container mt-5 text-center">
			<a href="{{ path('app_location_des_salles') }}" class="btn btn-dark-blue mb-4">Retour à la Page Location de Salle</a>
		</div>
	</div>
{% endblock %}

