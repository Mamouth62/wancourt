{% extends 'base.html.twig' %}

{% block title %}Wancourt Planning - Horaires{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            background: url('{{ asset('img/aire_jeu_sdf.JPG') }}') no-repeat center center fixed;
            background-size: cover;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
        }

        .content-wrapper {
            background-color: rgba(255, 255, 255, 0.85);
            padding: 20px;
            border-radius: 10px;
            margin-top: 20px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        h1, h2, h3 {
            color: rgba(51, 51, 51, 0.8);
            text-align: center;
        }

        .text-center {
            text-align: center;
        }

        .content-section {
            margin-top: 20px;
        }

        .content-section h2 {
            margin-bottom: 15px;
        }

        .content-section p {
            margin-bottom: 10px;
        }

        ul {
            color: rgba(51, 51, 51, 0.8);
            margin-left: 20px;
        }

        ul li {
            margin-bottom: 10px;
        }

        a {
            color: #007bff;
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="content-wrapper">
            <h1 class="mb-4">Plannings et horaires</h1>
            <p class="text-center">Cliquez sur l'article de votre choix pour lire le résumé complet.</p>
            <div class="table-responsive">
                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <td class="article-summary">
                                <h2 class="h4">Déchets Verts</h2>
                                <p>Voir les horaires</p>
                                <a href="{{ path('app_dechet_vert') }}" class="btn btn-dark-blue mb-4">Voir</a>
                            </td>
                            <td class="article-summary">
                                <h2 class="h4">Passage du SMAV</h2>
                                <p>Voir les horaires</p>
                                <a href="{{ path('app_smav') }}" class="btn btn-dark-blue mb-4">Voir</a>
                            </td>
                            <td class="article-summary">
                                <h2 class="h4">Bus Artis</h2>
                                <p>Voir les horaires</p>
                                <a href="https://storage.googleapis.com/is-wp-119-prod/uploads-prod/2024/05/Rurale-LIGNE14-web-13-05-2024.pdf" class="btn btn-dark-blue mb-4">Voir</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="container mt-5">
        <a href="{{ path('app_vie_pratique') }}" class="btn btn-dark-blue mb-4">Retour à la Page Vie Pratique</a>
    </div>
{% endblock %}

