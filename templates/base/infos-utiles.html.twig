			background: url('{{ asset('img/aire_jeu_sdf.JPG') }}') no-repeat center center fixed;
			background-size: cover;
		}

		.container {
			max-width: 1500px;
			margin: 0 auto;
		}

		.content-wrapper {
			background-color: rgba(255, 255, 255, 0.85);
			padding: 20px;
			border-radius: 10px;
			margin-top: 20px;
			box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
		}

		h1,
		h2,
		h3 {
			color: rgba(51, 51, 51, 0.8);
		}

		.text-center {
			text-align: center;
		}

		.img-fluid {
			max-width: 100%;
			height: auto;
		}


		a {
			color: #007bff;
			text-decoration: none;
		}

		a:hover {
			text-decoration: underline;
		}

		.table td {
			text-align: center;
			vertical-align: middle;
			border: 1px solid #ddd;
			padding: 20px;
			background-color: rgba(255, 255, 255, 0.7);
		}
