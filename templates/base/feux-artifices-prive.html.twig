{% extends 'base.html.twig' %}

{% block title %}Wancourt -
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		body {
			background: url('{{ asset('img/mairie.JPG') }}') no-repeat center center fixed;
			background-size: cover;
		}

		.container {
			max-width: 1500px;
			margin: 0 auto;
		}

		.content-wrapper {
			background-color: rgba(255, 255, 255, 0.85);
			padding: 20px;
			border-radius: 10px;
			margin-top: 20px;
			box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
		}
		.text-center img {
			max-width: 100%;
			height: auto;
			display: block;
			margin: 0 auto;
		}
	</style>
{% endblock %}
{% block body %}
	<div class="container mt-5">
		<div class="content-wrapper">
			<h1 class="mb-4">Feux d'Artifices Privé</h1>
		</div>
	</div>
{% endblock %}
