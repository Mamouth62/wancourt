{% extends 'base.html.twig' %}

{% block title %}Wancourt Agenda 2024 -{% endblock %}

{% block body %}
    <div class="container-fluid mt-5">
        <main class="main-content container-fluid mt-5">
            <h1 class="text-center mb-4">Agenda 2024</h1>
            <h2 class="text-center mb-4">Bienvenue sur l'Agenda de votre commune</h2>
            <div class="table-responsive">
                <table class="table table-striped table-bordered w-100 text-center">
                    <thead class="thead-dark">
                        <tr>
                            <th>Activité</th>
                            <th>Images</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% set activities = [
                            {'date': '14/01/2024', 'title': 'Voeux du Maire', 'images': ['img/voeuxm1.JPG', 'img/voeuxm2.JPG', 'img/voeuxm3.JPG', 'img/voeuxm4.JPG']},
                            {'date': '25/01/2024', 'title': 'Voeux des Associations', 'images': ['img/voeuxa1.JPG', 'img/voeuxa2.JPG', 'img/voeuxa3.JPG', 'img/voeuxa4.JPG']},
                            {'date': '24/02/2024', 'title': 'Salon de l\'agriculture à Paris', 'images': ['img/salona1.jpg', 'img/salona2.jpg', 'img/salona3.jpg']},
                            {'date': '08/05/2024', 'title': 'Cérémonie de l\'Armistice', 'images': ['img/8mai_1.JPG', 'img/8mai_2.JPG', 'img/8mai_3.JPG', 'img/8mai_4.JPG']},
                            {'date': '08/06/2024', 'title': 'Sortie Parc Bagatelle - La Journée', 'images': ['img/bagatelle1.jpg', 'img/bagatelle2.jpg', 'img/bagatelle3.jpg', 'img/bagatelle4.jpg']},
                            {'date': '16/06/2024', 'title': 'Marche', 'images': ['img/marche1.JPG', 'img/marche2.JPG', 'img/marche3.JPG', 'img/marche4.JPG']},
                            {'date': '13-15/07/2024', 'title': 'Ducasse - 3 jours', 'images': ['img/ducasse1.png', 'img/ducasse2.png', 'img/ducasse3.png', 'img/ducasse4.png']},
                            {'date': '08/09/2024', 'title': 'Marche au profit d\'une association caricative - Matin', 'images': ['img/caritative1.jpg', 'img/caritative2.jpg', 'img/caritative3.jpg', 'img/caritative4.jpg']},
                            {'date': '15/09/2024', 'title': '2ème brocante - Matin', 'images': ['img/brocante1.jpg', 'img/brocante2.jpg', 'img/brocante3.jpg', 'img/brocante4.jpg']},
                            {'date': '21/09/2024', 'title': 'Apprentissage de la danse pour le Téléthon 2024', 'images': ['img/danse1.jpg', 'img/danse2.jpg', 'img/danse3.jpg', 'img/danse4.jpg']},
                            {'date': '26/10/2024', 'title': 'Bourse aux jouets - Après-midi', 'images': ['img/jouets1.jpg', 'img/jouets2.jpg', 'img/jouets3.jpg', 'img/jouets4.jpg']},
                            {'date': '11/11/2024', 'title': 'Commémoration du 11 novembre - Matin', 'images': ['img/commemoration1.jpg', 'img/commemoration2.jpg', 'img/commemoration3.jpg', 'img/commemoration4.jpg']},
                            {'date': '23-24/11/2024', 'title': 'Action pour le Téléthon - 2 jours', 'images': ['img/telethon1.jpg', 'img/telethon2.jpg', 'img/telethon3.jpg', 'img/telethon4.jpg']},
                            {'date': '30/11/2024', 'title': 'Sortie Marché de Noël - Lieu à déterminer - 2 jours', 'images': ['img/noel1.jpg', 'img/noel2.jpg', 'img/noel3.jpg', 'img/noel4.jpg']},
                            {'date': '07/12/2024', 'title': 'Noël des aînés - Le midi', 'images': ['img/noela1.jpg', 'img/noela2.jpg', 'img/noela3.jpg', 'img/noela4.jpg']},
                            {'date': '15/12/2024', 'title': 'Noël des enfants- Après-midi', 'images': ['img/noele1.jpg', 'img/noele2.jpg', 'img/noele3.jpg', 'img/noele4.jpg']}
                        ] %}

                        {% for activity in activities %}
                            <tr>
                                <td>{{ activity.date }}: {{ activity.title }}</td>
                                <td class="activity-images d-flex justify-content-center">
                                    {% for image in activity.images %}
                                        <img src="{{ asset(image) }}" alt="Activité Image" class="img-thumbnail" data-bs-toggle="modal" data-bs-target="#imageModal{{ loop.index }}">
                                    {% endfor %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </main>

        <div class="container mt-1 text-center">
            <a href="{{ path('app_base') }}" class="btn btn-dark-blue mb-4">Retour à la Page Principale</a>
            <button onclick="window.print()" class="btn btn-dark-blue mb-4">Imprimer</button>
        </div>
    </div>

    <!-- Modal Structure -->
    <div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-body">
                    <img src="" alt="Modal Image" id="modalImage" class="w-100">
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    <style>
        .activity-images img {
            max-width: 100px;
            margin: 0 10px;
            transition: transform 0.2s;
            cursor: pointer;
        }
        .activity-images img:hover {
            transform: scale(1.1);
        }
        .table th,
        .table td {
            vertical-align: middle;
            text-align: center;
        }
        .table-responsive {
            width: 100%;
        }
        h1 {
            font-family: 'Georgia', serif;
        }
        .modal-body {
            padding: 0;
        }
    </style>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <script>
        document.addEventListener('DOMContentLoaded', (event) => {
            const modal = new bootstrap.Modal(document.getElementById('imageModal'));
            const modalImage = document.getElementById('modalImage');

            document.querySelectorAll('.activity-images img').forEach(img => {
                img.addEventListener('click', () => {
                    modalImage.src = img.src;
                    modal.show();
                });
            });
        });
    </script>
{% endblock %}

