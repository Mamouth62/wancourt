{% extends 'base.html.twig' %}

{% block title %}Wancourt - Education
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		body {
			background: url('{{ asset('img/ecole.JPG') }}') no-repeat center center fixed;
			background-size: cover;
		}

		.content-wrapper {
			background-color: rgba(255, 255, 255, 0.85);
			padding: 20px;
			border-radius: 10px;
			margin-top: 20px;
			box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
		}

		.container {
			max-width: 800px;
			margin: 0 auto;
			padding: 0 15px;
		}

		.card-deck .card {
			background-color: rgba(255, 255, 255, 0.85);
			border: none;
			box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
		}

		.card-body {
			padding: 20px;
		}

		.card h2 {
			color: rgba(51, 51, 51, 0.8);
			margin-bottom: 15px;
		}

		.card p {
			color: rgba(51, 51, 51, 0.8);
		}
		.table td {
			background-color: rgba(255, 255, 255, 0.85);
		}
	</style>
{% endblock %}

{% block body %}
	<div class="container mt-5">
		<div class="content-wrapper">
			<h1 class="headline text-primary">Education</h1>
			<p class="lead mb-4 text-center">Cliquez sur l'article de votre choix pour lire le résumé.</p>
			<div class="row justify-content-center">
				<div class="col-md-8">
					<div class="card-deck">
						<div class="card mb-4">
							<div class="card-body">
								<h2 class="h4">Regroupement Pédagogique Interscolaire (RPI)</h2>
								<p class="card-text">Découvrez le Regroupement Pédagogique Interscolaire pour l'éducation à Wancourt.</p>
								<a href="{{ path('app_rpi') }}" class="btn btn-dark-blue mb-4">Voir plus</a>
							</div>
						</div>

						<div class="card mb-4">
							<div class="card-body">
								<h2 class="h4">Relais Petite Enfance (RPE)</h2>
								<p class="card-text">Informations sur la réglementation concernant les assistantes maternelles.</p>
								<a href="{{ path('app_rpe') }}" class="btn btn-dark-blue mb-4">Voir plus</a>
							</div>
						</div>
					</div>
				</div>
				<div class="container mt-5 text-center">
					<a href="{{ path('app_base') }}" class="btn btn-dark-blue mb-4">Retour à la Page Accueil</a>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
