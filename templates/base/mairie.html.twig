{% extends 'base.html.twig' %}

{% block title %}Wancourt Mairie -
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		body {
			background: url('{{ asset('img/mairie.JPG') }}') no-repeat center center fixed;
			background-size: cover;
		}

		.content-wrapper {
			background-color: rgba(255, 255, 255, 0.85);
			padding: 20px;
			border-radius: 10px;
			margin-top: 20px;
		}

		.container {
			max-width: 800px;
			margin: 0 auto;
			padding: 0 15px;
		}

		.table {
			width: 100%;
			border-collapse: collapse;
			margin-bottom: 30px;
		}

		.table td {
			text-align: center;
			vertical-align: middle;
			border: 1px solid #ddd;
			padding: 20px;
			background-color: rgba(255, 255, 255, 0.85);
		}

		.table h2 {
			margin-bottom: 20px;
			color: rgba(51, 51, 51, 0.8);
		}

		.table p {
			color: rgba(51, 51, 51, 0.8);
		}

		.btn-center {
			display: flex;
			justify-content: center;
		}

		.btn-center .btn {
			margin: 0 auto;
		}

		.headline {
			color: rgba(51, 51, 51, 0.8);
		}

		.lead {
			color: rgba(51, 51, 51, 0.8);
		}
	</style>
{% endblock %}

{% block body %}
	<div class="container"><br><br>
		<div class="content-wrapper">
			<h1 class="headline text-primary">Mairie de Wancourt</h1>
			<p class="lead mb-4 text-center">Cliquez sur l'article de votre choix pour lire le résumé complet.</p>
			<div class="table-responsive">
				<table class="table table-bordered">
					<tbody>
						<tr>
							<td class="article-summary">
								<h2 class="h4">AGENDA 2024</h2>
								<div class="btn-center">
									<a href="{{ path('app_agenda') }}" class="btn btn-dark-blue mb-4">Voir</a>
								</div>
							</td>
							<td class="article-summary">
								<h2 class="h4">ARRETES COMMUNAUX</h2>
								<div class="btn-center">
									<a href="{{ path('app_arrete_communaux') }}" class="btn btn-dark-blue mb-4">Voir</a>
								</div>
							</td>
							<td class="article-summary">
								<h2 class="h4">CIMETIERE  WANCOURT</h2>
								<div class="btn-center">
									<a href="{{ path('app_cimetiere') }}" class="btn btn-dark-blue mb-4">Voir</a>
								</div>
							</td>
						</tr>
						<tr>
							<td class="article-summary">
								<h2 class="h4">COMMISSIONS DELEGATIONS</h2>
								<div class="btn-center">
									<a href="{{ path('app_commissions_et_delegations') }}" class="btn btn-dark-blue mb-4">Voir</a>
								</div>
							</td>
							<td class="article-summary">
								<h2 class="h4">HORAIRES-INFORMATIONS</h2>
								<div class="btn-center">
									<a href="{{ path('app_info') }}" class="btn btn-dark-blue mb-4">Voir</a>
								</div>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
			<div class="container mt-5 text-center">
				<a href="{{ path('app_base') }}" class="btn btn-dark-blue mb-4">Retour à la Page Principale</a>
			</div>
		</div><br>
	</div>
{% endblock %}
