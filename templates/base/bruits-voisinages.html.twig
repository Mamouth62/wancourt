{% extends 'base.html.twig' %}

{% block title %}Wancourt -{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .text-center img {
            max-width: 100%;
            height: auto;
            display: block;
            margin: 0 auto;
        }
        .gallery-item {
            margin-bottom: 30px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">Bruits de voisinage</h1>
    
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="text-center gallery-item">
                {% set img1 = 'img/bruit_voisin1.png' %}
                <img src="{{ asset(img1) }}" class="img-fluid" alt="Bruit Voisin 1">
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="text-center gallery-item">
                {% set img2 = 'img/bruit_voisin2.png' %}
                <img src="{{ asset(img2) }}" class="img-fluid" alt="Bruit Voisin 2">
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="text-center gallery-item">
                {% set img3 = 'img/bruit_voisin3.png' %}
                <img src="{{ asset(img3) }}" class="img-fluid" alt="Bruit Voisin 3">
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="text-center gallery-item">
                {% set img4 = 'img/bruit_voisin4.png' %}
                <img src="{{ asset(img4) }}" class="img-fluid" alt="Bruit Voisin 4">
            </div>
        </div>
    </div>

    <div class="container mt-5 d-flex justify-content-between">
        <a href="{{ path('app_arrete_communaux') }}" class="btn btn-dark-blue mb-4">Retour à la Arrêtés Communaux</a>
        <button onclick="window.print()" class="btn btn-dark-blue mb-4">Imprimer</button>
    </div>
</div>
{% endblock %}

